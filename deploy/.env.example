# Keelarr keeps this file in step with the paths you choose in its settings,
# so there is usually no reason to edit it by hand. Copy it to .env and run
# `docker compose -f compose.example.yml up -d` — every value below has a
# working default, and the setup wizard detects the right ones for your machine
# on first run.
#
# After changing paths in the app, recreate the controller to apply them:
#   docker compose -f compose.example.yml up -d

# The controller itself.
#
# KEELARR_VERSION pins the published image. Left unset it tracks `latest`,
# which is what most people want; set it to a released tag such as v0.2.0 if
# you would rather decide when the controller moves.
KEELARR_VERSION=
KEELARR_PORT=4687
KEELARR_DATA_DIR=../data
KEELARR_LOG_LEVEL=info

# Where Keelarr writes the Compose files it generates, and where each app
# keeps its configuration and database.
#
# Left blank, these default to placeholders under your home directory, which is
# always mountable. The wizard replaces them with this machine's real paths.
HOST_STACK_ROOT=
HOST_CONFIG_ROOT=

# Your media library and where completed downloads land. These are the two most
# likely to differ on your machine — a QNAP typically uses /share/Media, a
# Synology /volume1/media.
HOST_MEDIA_ROOT=
HOST_DOWNLOADS_ROOT=

# Only used by Tautulli, for Plex log health. Leave as-is if you do not use it.
HOST_PLEX_LOGS_ROOT=
